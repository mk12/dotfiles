// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "minimap": {
    "show": "auto"
  },
  "file_scan_exclusions": [".zig-cache"],
  "theme": {
    "light": "macOS Classic Light",
    "dark": "VSCode Dark Modern"
  },
  "experimental.theme_overrides": {
    "editor.wrap_guide": "#666"
  },
  "wrap_guides": [80],
  "buffer_font_size": 14,
  "buffer_line_height": "standard",
  "buffer_font_family": "Iosevka",
  "buffer_font_weight": 500,
  "terminal": {
    "option_as_meta": true
  },
  "format_on_save": "off",
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "tab_size": 4
    },
    "Python": {
      // Until they fix the .ropeproject thing:
      // https://github.com/zed-industries/zed/issues/22085
      "enable_language_server": false
    },
    "HTML": {
      "tab_size": 2
    },
    "CSS": {
      "language_servers": []
    },
    "Zig": {
      "format_on_save": "on"
    }
  },
  "lsp": {
    "zls": {
      "binary": {
        "path": "/Users/mk/.local/bin/zls"
      }
    }
  }
}
